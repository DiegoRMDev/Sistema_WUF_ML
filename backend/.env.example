# Copiar como backend/.env y reemplazar todos los valores de ejemplo.
ENVIRONMENT=development
APP_NAME=WUF Predict API
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/wuf_predict_v9
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=wuf-predict
ACCESS_TOKEN_MINUTES=30
LOGIN_ATTEMPTS_PER_MINUTE=5
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
API_OFFSET_MAX=100000
CATALOG_CSV_MAX_BYTES=20000000
MODEL_ARTIFACT_DIR=../artifacts/models
MODEL_MIN_ACCURACY=0.75
MODEL_DEFAULT_TEST_SIZE=0.2
MODEL_DEFAULT_ESTIMATORS=300
MODEL_RANDOM_SEED=42
MODEL_PRIORITY_HIGH_MAX=0.35
MODEL_PRIORITY_MEDIUM_MAX=0.65
CONSISTENCY_TEST_SIZE=0.25
CONSISTENCY_RANDOM_SEED=42
CONSISTENCY_MAX_DEPTH=3
CONSISTENCY_HIGH_MIN_CAPTURES=3
CONSISTENCY_HIGH_MIN_AGE_DAYS=180
CONSISTENCY_MEDIUM_MIN_CAPTURES=2
CONSISTENCY_MEDIUM_MIN_AGE_DAYS=60
CONSISTENCY_MAX_CAPTURE_GAP_DAYS=14
SEGMENTATION_RANDOM_SEED=42
SEGMENTATION_N_INIT=20
DASHBOARD_OE1_TARGET_INCREASE_PERCENT=25
DASHBOARD_OE2_TARGET_ACCURACY_PERCENT=98
DASHBOARD_OE3_TARGET_COVERAGE_PERCENT=100
DASHBOARD_HISTORY_CAPTURE_LIMIT=6
DASHBOARD_ACTIVITY_LIMIT=8
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
