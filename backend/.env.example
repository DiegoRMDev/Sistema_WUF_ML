# Copiar como backend/.env y reemplazar todos los valores de ejemplo.
ENVIRONMENT=development
APP_NAME=WUF Predict API
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/wuf_predict_v2
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=wuf-predict
ACCESS_TOKEN_MINUTES=30
LOGIN_ATTEMPTS_PER_MINUTE=5
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
API_OFFSET_MAX=100000
CATALOG_CSV_MAX_BYTES=20000000
MODEL_ARTIFACT_DIR=../artifacts/models
MODEL_MIN_ACCURACY=0.75
MODEL_DEFAULT_TEST_SIZE=0.2
MODEL_DEFAULT_ESTIMATORS=300
MODEL_RANDOM_SEED=42
MODEL_PRIORITY_HIGH_MAX=0.35
MODEL_PRIORITY_MEDIUM_MAX=0.65
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
